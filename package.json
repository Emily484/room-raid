{
  "name": "room-raid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/index.js",
    "server:dev": "nodemon --watch server --exec node server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage": "npx c8 --reporter=text --reporter=html npm test",
    "coverage:lcov": "npx c8 --reporter=lcov --reporter=text npm test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "openai": "^4.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "react-router-dom": "^6.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^21.1.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "vite": "^8.2.0",
    "vitest": "^1.6.1"
  }
}
